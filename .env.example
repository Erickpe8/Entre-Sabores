APP_NAME="Entre Sabores"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=entre_sabores
DB_USERNAME=entre_sabores
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=100001
REVERB_APP_KEY=entre-sabores-local-key
REVERB_APP_SECRET=entre-sabores-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=9090
REVERB_HOST=127.0.0.1
REVERB_PORT=9090
REVERB_SCHEME=http

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

MARIDAJE_AI_API_KEY=
MARIDAJE_AI_BASE_URL=https://api.deepseek.com/v1
MARIDAJE_AI_MODEL=deepseek-chat
MARIDAJE_AI_TIMEOUT=90

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

IMAGE_DRIVER=
PROFILE_PHOTO_WEBP_QUALITY=78

# Análisis IA (maridaje) — solo backend; POST {MARIDAJE_AI_BASE_URL}/chat/completions
MARIDAJE_AI_API_KEY=
MARIDAJE_AI_BASE_URL=https://api.openai.com/v1
MARIDAJE_AI_MODEL=gpt-4o-mini
MARIDAJE_AI_TIMEOUT=90

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=9090
VITE_REVERB_SCHEME=http

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=6001
VITE_PUSHER_SCHEME=http
