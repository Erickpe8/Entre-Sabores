# Variables de referencia para despliegue en Vercel (Container + servicios externos).
# Configúralas en Vercel Dashboard > Project Settings > Environment Variables.
# No commitear secretos reales.

APP_NAME="Entre Sabores"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://entre-sabores.vercel.app

# Obligatorio — vacío rompe el arranque (ArgumentCountError en maintenance manager)
APP_MAINTENANCE_DRIVER=file

# Obligatorio — generar con: php artisan key:generate --show
# Sin APP_KEY todas las rutas Laravel responden 500.

# Vercel termina TLS; FrankenPHP escucha en $PORT detrás del proxy.
TRUSTED_PROXIES=*

# Base de datos externa (MySQL gestionado: PlanetScale, Railway, Aiven, etc.)
# Sin DB_* la app arranca pero rutas con datos fallarán.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Redis — solo activar SESSION/CACHE/QUEUE en redis cuando REDIS_URL o REDIS_HOST estén definidos.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

# Valores seguros hasta conectar Upstash (evita bloqueo contra 127.0.0.1)
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

# Cuando tengas Upstash, cambia a:
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# REDIS_URL=rediss://...

# Migraciones en cada arranque del contenedor (opcional; alternativa: manual o CI)
VERCEL_RUN_MIGRATIONS=0

# Vercel Cron — debe coincidir con el secreto del proyecto (Authorization: Bearer)
CRON_SECRET=

# Broadcasting: Reverb no corre en Vercel; usar Pusher Cloud o Soketi externo.
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# Build-time (Vite) — definir también en Vercel para Production y Preview
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST=
VITE_PUSHER_PORT=443
VITE_PUSHER_SCHEME=https

# Almacenamiento persistente (local del contenedor se pierde al escalar)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

# IA maridaje
MARIDAJE_AI_API_KEY=
MARIDAJE_AI_BASE_URL=https://api.openai.com/v1
MARIDAJE_AI_MODEL=gpt-4o-mini
MARIDAJE_AI_TIMEOUT=90

LOG_CHANNEL=stderr
LOG_LEVEL=info

MONITORING_METRICS_ENABLED=true
METRICS_TOKEN=
HEALTH_CHECK_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
